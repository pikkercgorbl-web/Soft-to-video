PEXELS_API_KEY=
PIXABAY_API_KEY=
GEMINI_API_KEY=

MEDIA_TYPE=video

# Подбор и скачивание видеоряда. false = только озвучка (без Pexels/Pixabay).
# MEDIA_DOWNLOAD_ENABLED=true
ORIENTATION=landscape
GLOBAL_VIBE=

STRESS_AUTOCORRECT_ENABLED=true
STRESS_FILL_UNMARKED=false

# Опционально:
# CHATTERBOX_TTS_URL=http://localhost:8004/tts
# TTS_SERVER_TIMEOUT=300
# SCRIPT_CHUNK_MAX_CHARS=400
# TTS_TEMPERATURE=0.5
# TTS_EXAGGERATION=1.0
# TTS_CFG_WEIGHT=0.6
# TTS_CHUNK_SIZE=100

# Чистка придыханий/шорохов в паузах между фразами.
# AUDIO_PAUSE_CLEAN=true
# Консервативные значения: сохраняют тихую речь.
# AUDIO_PAUSE_ENTER_DB=-36
# AUDIO_PAUSE_EXIT_DB=-48
# AUDIO_PAUSE_MIN_MS=180
# AUDIO_PAUSE_GUARD_MS=80
# Опасное объединение/продление выключено (0): оно может удалить тихое слово.
# AUDIO_PAUSE_BRIDGE_MAX_MS=0
# AUDIO_PAUSE_BRIDGE_PEAK_DB=-20
# AUDIO_PAUSE_TAIL_EXTEND_MS=0
# AUDIO_PAUSE_TAIL_PEAK_DB=-18
# Безопасная очистка по точным стыкам Chatterbox.
# AUDIO_STITCH_CLEAN=true
# AUDIO_STITCH_MIN_ZERO_MS=100
# AUDIO_STITCH_FADE_BEFORE_MS=40
# Классификатор речи: удаляет ветер/шорох/вой, сохраняя окружение слов.
# AUDIO_VAD_CLEAN=true
# AUDIO_VAD_AGGRESSIVENESS=3
# AUDIO_VAD_SPEECH_PAD_MS=180
# AUDIO_VAD_MIN_NONSPEECH_MS=120
# Глобальный ВЧ-фильтр выключен: шипящие слова похожи на шум.
# У стыков этот анализ применяется автоматически и безопаснее.
# AUDIO_SPECTRAL_CLEAN=false
# AUDIO_SPECTRAL_MIN_REGION_MS=220
# AUDIO_SPECTRAL_MAX_GAP_MS=80
# Сохранять исходный WAV до обработки в downloads/raw.
# AUDIO_KEEP_RAW=true

# Смысловой подбор видеоряда
# MEDIA_SEMANTIC_ENABLED=true
# MEDIA_CANDIDATE_POOL=10
# MEDIA_RANKER=llm            # llm | embedding | lexical
# MEDIA_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# USED_MEDIA_STORE=used_media.json
# MEDIA_SELECTION_LOG=media_selection.log
